{
  "name": "titqmis-nakhevari",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "postbuild": "node scripts/sync-spa-shell.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "check:listing-search": "node scripts/check-listing-search.js",
    "test": "vitest run tests/utils",
    "test:rules": "firebase emulators:exec --only firestore,storage \"vitest run tests/rules\"",
    "test:functions": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 GCLOUD_PROJECT=nakhevari-functions-test firebase emulators:exec --only firestore,auth \"vitest run tests/functions\"",
    "test:all": "npm run test && npm run test:rules && npm run test:functions",
    "preview": "vite preview"
  },
  "dependencies": {
    "@daypicker/react": "^10.0.1",
    "@reduxjs/toolkit": "^2.12.0",
    "firebase": "12.15.0",
    "i18next": "25.5.2",
    "lucide-react": "1.21.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-i18next": "15.7.3",
    "react-redux": "^9.3.0",
    "react-router-dom": "7.18.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "autoprefixer": "10.5.0",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.6.0",
    "postcss": "8.5.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1",
    "vite": "8.0.16",
    "vitest": "^4.1.10"
  }
}
